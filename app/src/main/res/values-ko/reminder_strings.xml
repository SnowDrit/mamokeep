<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="reminders_title">알림</string>
    <string name="reminders_intro">모든 차량, 부품, 정비, 서류에 적용되는 기본 일정입니다. 개별 항목마다 다른 일정을 선택할 수 있습니다.</string>
    <string name="reminders_enabled">알림 보내기</string>
    <string name="reminders_disabled_hint">이 일정의 알림은 꺼져 있습니다. 정비 주기와 이력은 계속 사용할 수 있습니다.</string>
    <string name="reminders_time">알림 시간</string>
    <string name="reminders_time_select">시간 선택</string>
    <string name="reminders_time_dialog">알림 시간(24시간제)</string>
    <string name="reminders_hours">시</string>
    <string name="reminders_minutes">분</string>
    <string name="reminders_time_hint">휴대전화의 현지 시간을 사용합니다. Android가 배터리를 절약하기 위해 알림을 늦게 전달할 수 있습니다.</string>
    <string name="reminders_weekdays">요일</string>
    <string name="reminders_every_day">매일</string>
    <string name="reminders_six_days">6일</string>
    <string name="reminders_workdays">평일</string>
    <string name="reminders_weekdays_hint">원하는 요일을 선택할 수 있습니다. “6일”은 월요일부터 토요일을 선택하며, 선택은 변경할 수 있습니다.</string>
    <string name="reminders_weekdays_error">하루 이상 선택하세요.</string>
    <string name="reminders_basic_hint">기본적으로 노란 단계에서 알림이 시작되고, 작업을 완료로 기록할 때까지 선택한 요일에 반복됩니다.</string>
    <plurals name="reminders_days_selected">
        <item quantity="other">주 %1$d일</item>
    </plurals>
    <string-array name="reminders_weekdays_short">
        <item>월</item>
        <item>화</item>
        <item>수</item>
        <item>목</item>
        <item>금</item>
        <item>토</item>
        <item>일</item>
    </string-array>
    <string-array name="reminders_weekdays_full">
        <item>월요일</item>
        <item>화요일</item>
        <item>수요일</item>
        <item>목요일</item>
        <item>금요일</item>
        <item>토요일</item>
        <item>일요일</item>
    </string-array>
    <string name="reminders_advanced_show">고급 설정</string>
    <string name="reminders_advanced_hide">고급 설정 숨기기</string>
    <string name="reminders_advanced_enabled">사용자 지정 기준 및 반복 사용</string>
    <string name="reminders_advanced_hint">노란 단계는 항목의 “노란 단계 설정”을 따르며, 빨간 단계는 정비 시기가 되었음을 뜻합니다. 이 설정은 알림 시작 시점을 바꾸며 정비 카드의 색상은 바꾸지 않습니다.</string>
    <string name="reminders_advance_hint">0은 해당 단계에 도달했을 때를 뜻합니다. 거리와 일수를 모두 설정하면 먼저 도달하는 기준에 따라 알림이 시작됩니다. 거리는 추정 주행 거리를 사용하며, 새 주행 거리계 기록으로 추정값이 더 정확해집니다.</string>
    <string name="reminders_yellow">노란 단계 · 정비 시기 임박</string>
    <string name="reminders_red">빨간 단계 · 정비 시기</string>
    <string name="reminders_advance_distance">이 단계보다 미리 알림, %1$s</string>
    <string name="reminders_advance_days">이 단계보다 미리 알림, 일</string>
    <string name="reminders_repeat_days">최소 반복 간격, 일</string>
    <string name="reminders_max_occurrences">단계별 최대 알림 횟수</string>
    <string name="reminders_repeat_hint">선택한 요일에만 반복되며 항목별로 하루 최대 한 번 전달됩니다. 노란색 또는 빨간색에 도달하면 새 단계가 시작되고 횟수를 다시 셉니다.</string>
    <string name="reminders_limit_hint">0은 제한 없음을 뜻합니다. 정비를 완료로 기록하면 횟수가 초기화됩니다.</string>
    <string name="reminders_number_error">%1$s부터 %2$s 사이의 정수를 입력하세요.</string>
    <string name="reminders_save_error">알림을 저장하지 못했습니다. 다시 시도하세요.</string>
    <string name="reminders_permission_hint">Android가 알림을 차단했습니다. 일정은 저장할 수 있지만 알림을 허용해야 안내를 받을 수 있습니다.</string>
    <string name="reminders_permission_settings">알림 설정 열기</string>
</resources>
